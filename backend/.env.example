SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
CORS_ORIGINS=http://localhost:5173

# Chat model: any OpenAI-compatible Chat Completions endpoint (default: local Ollama)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b

# Embeddings (EMBEDDING_BASE_URL / EMBEDDING_API_KEY fall back to LLM_* when empty)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embeddinggemma
# Must match vector(N) in supabase/migrations/0002 (changing it needs a migration + re-ingest)
EMBEDDING_DIM=768
# EmbeddingGemma works best with: "task: search result | query: " and "title: none | text: "
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOC_PREFIX=
EMBEDDING_BATCH_SIZE=64

# Ingestion
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_BYTES=5000000

# Retrieval / agent
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.25
MAX_TOOL_ITERATIONS=3

# Conversation history sent to the (stateless) model each turn
HISTORY_MAX_MESSAGES=20
HISTORY_MAX_CHARS=24000

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=agentic-rag
